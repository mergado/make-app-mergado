        {
            "id": "product.search",
            "resource": "product",
            "operation": "search",
            "method": "POST",
            "endpoint": "/projects/{projectId}/products",
            "scope": "project.products.read",
            "inputs": [
                {
                    "name": "shopId",
                    "type": "select",
                    "label": "E-shop",
                    "required": true,
                    "source": "vyber:shop"
                },
                {
                    "name": "projectId",
                    "type": "select",
                    "label": "Project",
                    "required": true,
                    "source": "vyber:project"
                },
                {
                    "name": "mql",
                    "type": "text",
                    "label": "MQL query",
                    "required": false,
                    "help": "Condition in Mergado Query Language, for example `PRICE_VAT < 100`. It is evaluated on the input values of the products. Element names are case-sensitive. Leave empty to return all products."
                },
                {
                    "name": "isHidden",
                    "type": "select",
                    "label": "Visibility",
                    "required": false,
                    "options": [
                        {
                            "label": "Only visible products",
                            "value": "false"
                        },
                        {
                            "label": "Only hidden products",
                            "value": "true"
                        }
                    ],
                    "help": "Leave empty to return both visible and hidden products."
                },
                {
                    "name": "valuesToExtract",
                    "type": "text",
                    "label": "Values to extract",
                    "required": false,
                    "help": "Comma-separated element paths or variable names, for example `ITEM_ID,PRICE_VAT,PARAM | PARAM_NAME`. The response then contains only these values in Extracted values instead of all product data."
                }
            ],
            "request": {
                "body": {
                    "mql": "$mql"
                },
                "qs": {
                    "is_hidden": "$isHidden",
                    "values_to_extract": "$valuesToExtract|csvJsonArray"
                }
            },
            "pagination": {
                "type": "limit-offset",
                "pageSize": 100,
                "total": "total_results"
            },
            "iterate": "data",
            "output": {
                "schema": {
                    "path": "/projects/{id}/products",
                    "method": "post",
                    "item": true
                },
                "keyFields": [
                    "id",
                    "data",
                    "extracted_values",
                    "updated_at"
                ],
                "pozn": "data a extracted_values se vylučují: s values_to_extract přijde jen extracted_values. is_hidden a další ruční stav jen s include_additional_fields=true, který se neposílá (ověřeno naživo z n8n 30. 10.)."
            },
            "make": {
                "name": "searchProducts",
                "label": "Search Products",
                "description": "Returns a list of products in a specific project filtered by an MQL query.",
                "type": "search"
            },
            "n8n": {
                "resource": "product",
                "operation": "search",
                "name": "Search"
            },
            "scenar": "Každé ráno najít produkty bez obrázku (MQL) a poslat jejich seznam e-mailem."
