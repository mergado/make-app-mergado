{
    "_popis": {
        "ucel": "Zdroj pravdy pro funkce Mergada v Make appce (make-app-mergado/) a v n8n nodu (n8n-nodes-mergado/). Obsah je stejný, tvar (názvy, typy modulů) podle platformy. Make moduly se z tohoto souboru generují: node make-app-mergado/scripts/generate.mjs.",
        "api": "Základ API: baseUrl, hlavička s verzí (bez ní API odpovídá ve formátu z roku 2020) a kopie OpenAPI spec, ze které se berou výstupní pole.",
        "slovnik": "Jednotné pojmy pro popisky a nápovědu na obou platformách.",
        "vybery": "Rozbalovací seznamy (Make RPC, n8n listSearch): endpoint, label a value, na čem závisí (dependsOn), filtr položek, help (nápověda pole, které výběr používá) a limit (max. počet položek ve výběru).",
        "funkce[].id": "Stabilní ID funkce: <resource>.<operation>.",
        "funkce[].resource / operation": "Neutrální pojmenování (n8n styl). operation: get, getAll, search, create, getCurrent, pauseResume, watch, call.",
        "funkce[].method / endpoint": "HTTP metoda a cesta. {param} odkazuje na vstup se stejným jménem. Výjimka: {userId} není vstup, je to ID přihlášeného uživatele.",
        "funkce[].scope": "OAuth scope, který funkce potřebuje (musí být v connection.scope Make appky i v n8n credentialu).",
        "funkce[].inputs": "Vstupy: name, type (text | select | boolean | uinteger | array), label, required, help, options (pro pevný select), source = 'vyber:<id>' pro rozbalovací seznam. platforms = jen pro vyjmenované platformy (chybí = obě).",
        "funkce[].request": "Co se posílá: qs a body. Hodnota '$name' = vstup (prázdný nepovinný vstup se vynechá), '$name|csvJsonArray' = text oddělený čárkami převedený na JSON pole řetězců (values_to_extract=[\"A\",\"B\"]). Ostatní hodnoty jsou konstanty.",
        "funkce[].pagination": "null, nebo { type: 'limit-offset', pageSize, total } – total je pole s celkovým počtem v odpovědi. Uživatel zadává jen Limit (Make) / Return All + Limit (n8n).",
        "funkce[].iterate": "Kde je v odpovědi seznam položek (např. 'data'); chybí = odpověď je jedna položka.",
        "funkce[].output": "schema = odkud v OpenAPI vzít výstupní pole (path, method, item = true když jde o položku seznamu data[]); keyFields = klíčová pole pro help a ukázky; computed = pole, která API nevrací a dopočítáváme je ({pole} = hodnota z položky).",
        "funkce[].trigger": "Jen pro watch: log, statuses (filtr status in […]), orderBy, dateField. Make: polling trigger s epoch, n8n: MergadoTrigger s event.",
        "funkce[].make": "Make: name (ID modulu), label, description, type (search | action | trigger | universal).",
        "funkce[].n8n": "n8n: resource, operation a name operace v n8n-nodes-mergado (u triggeru node MergadoTrigger a event). Pole, pokud funkci v n8n pokrývá víc operací; null = v n8n zatím není.",
        "funkce[].scenar": "Ukázkový scénář použití (pro help a žádost o review).",
        "app": "Název a krátký popis aplikace (Make: app description, n8n: description v Mergado.node.json)."
    },
    "api": {
        "baseUrl": "https://api.mergado.com",
        "version": "2026-10-30",
        "headers": {
            "use-mergado-api-version": "2026-10-30"
        },
        "openapi": "mergado-api/openapi-2026-10-30.json",
        "outputFeedUrl": "https://feeds.mergado.com/{slug}.xml"
    },
    "slovnik": {
        "e-shop": "E-shop (shop) – nejvyšší úroveň, vlastní projekty.",
        "project": "Projekt – jeden výstupní feed pro jeden kanál. Pole url je VSTUPNÍ feed, výstupní je output_feed_url.",
        "query": "Výběr (query) – uložený filtr produktů v MQL.",
        "rule": "Pravidlo – úprava dat v projektu. Stav se popisuje jen jako Pause / Resume (pole applies: false = paused, true = active).",
        "mql": "MQL – Mergado Query Language, vyhodnocuje se nad vstupními hodnotami produktů, názvy elementů rozlišují velikost písmen.",
        "element": "Element – cesta v datech produktu (např. PRICE_VAT, PARAM | PARAM_NAME)."
    },
    "vybery": {
        "shop": {
            "endpoint": "/users/{userId}/shops/",
            "label": "{name}",
            "value": "id",
            "pozn": "{userId} = ID přihlášeného uživatele (z GET /me/ nebo user_id z odpovědi na token). Hodnota me nefunguje – /users/me/shops/ vrací 404 (ověřeno v Make 30. 10.).",
            "help": "Mergado e-shop. The list shows the e-shops your Mergado account has access to.",
            "limit": 300
        },
        "project": {
            "endpoint": "/shops/{shopId}/projects/",
            "dependsOn": "shop",
            "label": "{name} ({output_format})",
            "value": "id",
            "help": "Project (output feed) of the selected e-shop; the output channel is in brackets. To enter a project ID instead, switch on Map.",
            "limit": 300
        },
        "rule": {
            "endpoint": "/projects/{projectId}/rules/",
            "dependsOn": "project",
            "label": "{name|element_path|id} ({type}, active|paused)",
            "value": "id",
            "help": "Rule of the selected project. To enter a rule ID instead, switch on Map.",
            "limit": 300
        },
        "pausableRule": {
            "endpoint": "/projects/{projectId}/rules/",
            "dependsOn": "project",
            "label": "{name|element_path|id} ({type}, active|paused)",
            "value": "id",
            "filter": "is_pausable = true",
            "pozn": "Skryje pravidla, která pozastavit nejde (převod formátu, pravidla rozšíření Bidding Fox, Pricing Fox, Feed Image Editor).",
            "help": "Rule of the selected project. Only rules that can be paused are listed, so format conversion rules and rules of paid extensions (Bidding Fox, Pricing Fox, Feed Image Editor) are left out. To enter a rule ID instead, switch on Map.",
            "limit": 300
        }
    },
