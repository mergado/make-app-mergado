{
    "authorize": {
        "url": "https://app.mergado.com/oauth2/authorize/",
        "temp": {
            "codeVerifier": "{{sha256(uuid + ':' + now)}}"
        },
        "qs": {
            "client_id": "{{common.clientId}}",
            "redirect_uri": "{{oauth.localRedirectUri}}",
            "response_type": "code",
            "grant_type": "authorization_code",
            "scope": "{{join(oauth.scope, ' ')}}",
            "code_challenge": "{{join(split(join(split(substring(sha256(temp.codeVerifier, 'base64'), 0, 43), '+'), '-'), '/'), '_')}}",
            "code_challenge_method": "S256"
        },
        "response": {
            "temp": {
                "code": "{{query.code}}"
            }
        }
    },
    "token": {
        "url": "https://app.mergado.com/oauth2/token/",
        "method": "POST",
        "type": "json",
        "body": {
            "client_id": "{{common.clientId}}",
            "redirect_uri": "{{oauth.localRedirectUri}}",
            "grant_type": "authorization_code",
            "code": "{{temp.code}}",
            "code_verifier": "{{temp.codeVerifier}}"
        },
        "response": {
            "data": {
                "accessToken": "{{body.access_token}}",
                "refreshToken": "{{body.refresh_token}}",
                "expires": "{{addSeconds(now, body.expires_in)}}",
                "entityId": "{{body.entity_id}}",
                "userId": "{{body.user_id}}"
            },
            "error": {
                "message": "[{{statusCode}}] {{ifempty(body.error_description, ifempty(body.error, body.message))}}"
            }
        },
        "log": {
            "sanitize": [
                "request.body.code",
                "request.body.code_verifier",
                "response.body.access_token",
                "response.body.refresh_token"
            ]
        }
    },
    "refresh": {
        "condition": "{{data.expires < addMinutes(now, 5)}}",
        "url": "https://app.mergado.com/oauth2/token/",
        "method": "POST",
        "type": "json",
        "body": {
            "client_id": "{{common.clientId}}",
            "grant_type": "refresh_token",
            "refresh_token": "{{data.refreshToken}}"
        },
        "response": {
            "data": {
                "accessToken": "{{body.access_token}}",
                "refreshToken": "{{ifempty(body.refresh_token, data.refreshToken)}}",
                "expires": "{{addSeconds(now, body.expires_in)}}",
                "entityId": "{{ifempty(body.entity_id, data.entityId)}}",
                "userId": "{{ifempty(body.user_id, data.userId)}}"
            },
            "error": {
                "message": "[{{statusCode}}] {{ifempty(body.error_description, ifempty(body.error, body.message))}}"
            }
        },
        "log": {
            "sanitize": [
                "request.body.refresh_token",
                "response.body.access_token",
                "response.body.refresh_token"
            ]
        }
    },
    "info": {
        "url": "https://api.mergado.com/me/",
        "headers": {
            "authorization": "Bearer {{connection.accessToken}}",
            "accept": "application/json",
            "use-mergado-api-version": "2026-10-30"
        },
        "response": {
            "metadata": {
                "type": "text",
                "value": "{{ifempty(body.email, body.username)}}"
            },
            "uid": "{{body.id}}",
            "error": {
                "message": "[{{statusCode}}] {{ifempty(body.message, 'Mergado did not accept the access token.')}}"
            }
        },
        "log": {
            "sanitize": [
                "request.headers.authorization"
            ]
        }
    }
}
