{
    "url": "/projects/{{parameters.projectId}}/rules/",
    "method": "GET",
    "response": {
        "iterate": {
            "container": "{{body.data}}",
            "condition": "{{item.is_pausable = true}}"
        },
        "output": {
            "label": "{{ifempty(item.name, ifempty(item.element_path, item.id))}} ({{item.type}}, {{if(item.applies, 'active', 'paused')}})",
            "value": "{{item.id}}"
        },
        "limit": 300
    }
}
